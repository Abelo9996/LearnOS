# LearnOS Environment Variables
# Everything here is OPTIONAL — LearnOS runs out of the box with no config.
# Copy to .env and fill in only what you want.

# ── LLM provider: OpenRouter ─────────────────────────────────────────────────
# LearnOS talks to models through OpenRouter (https://openrouter.ai) — one key
# unlocks every major model (Anthropic, OpenAI, Google, Meta, …) by slug.
# Get a key at https://openrouter.ai/keys. You can also add it in-app under
# Settings → API Keys instead of setting it here.
OPENROUTER_API_KEY=

# Default model when no per-agent routing is set. Any OpenRouter slug works —
# browse them at https://openrouter.ai/models.
LEARNOS_DEFAULT_MODEL=anthropic/claude-haiku-4.5

# ── Optional: encryption key for keys stored in-app ──────────────────────────
# 32-byte base64/hex value used to encrypt API keys saved via the UI at rest.
# If unset, a key is derived automatically — fine for local single-user use.
LEARNOS_ENC_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Used for outbound request attribution and CORS origin in production.
APP_URL=http://localhost:3001
