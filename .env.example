# LearnOS Environment Variables
# Copy to .env and fill in values.
# ── Required in production ──────────────────────────────────────────────────
# JWT signing secret — must be a strong random string in production.
# Generate: openssl rand -hex 32
LEARNOS_JWT_SECRET=change-me-to-a-random-hex-string

# ── Optional: managed Anthropic key ──────────────────────────────────────────
# If set, new users can use LearnOS without providing their own key (subject to usage caps).
# If unset, users must provide their own Anthropic API key in Settings → API Keys.
LEARNOS_ANTHROPIC_KEY=
# Alias (checked if LEARNOS_ANTHROPIC_KEY is unset):
ANTHROPIC_API_KEY=

# Default model for agent calls when no per-agent routing is configured.
LEARNOS_DEFAULT_MODEL=claude-haiku-4-5

# ── Optional: email (password reset / verification) ──────────────────────────
# If unset in production, /api/auth/forgot and /api/auth/verify return 503.
# In dev mode, email bodies are logged to logs/email.log instead.
RESEND_API_KEY=
EMAIL_FROM=LearnOS <noreply@learnos.dev>

# ── Optional: app URL (used in email links) ──────────────────────────────────
APP_URL=http://localhost:3001

# ── Optional: managed-tier usage cap ──────────────────────────────────────────
# Max tokens per user per month when using the managed key. 0 = unlimited.
MANAGED_MONTHLY_TOKEN_CAP=500000

# ── Optional: seed demo data ─────────────────────────────────────────────────
# Set to 1 to seed demo user (alex@learnos.dev / learnos123) on first boot.
# Leave unset in production.
LEARNOS_SEED=1

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
