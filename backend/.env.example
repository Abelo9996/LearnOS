# LearnOS Backend Configuration
DATABASE_PATH=learnos.db
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Mode: "online" (auth enforced) or "offline" (no auth, personal use)
LEARNOS_MODE=offline

# JWT Secret (change in production!)
JWT_SECRET=change-me-to-a-random-secret-in-production

# OpenAI — users can also configure via the UI
OPENAI_API_KEY=

# OAuth — leave empty to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
